# Every environment variable the app reads (api/env.ts, vite.config.ts).
# Values must be unquoted: Node's --env-file strips quotes but `docker run
# --env-file` keeps them, which breaks URL parsing.

# --- Required ---

# The direct connection (db.<project-ref>.supabase.co:5432), for queries and
# the realtime bus, which LISTENs on it. No pooler.
DATABASE_URL=
# Supabase project URL and anon key; the browser uses them for Auth.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key, used server-side for Devcon handover sign-ins.
SUPABASE_SERVICE_ROLE_KEY=
# Shared HS256 secret for verifying Devcon handover tokens (the Devcon app's
# VERIFICATION_SECRET).
DEVCON_VERIFICATION_SECRET=

# --- Optional ---

# Connections per server (default 10), plus one for the realtime bus. Keep
# machines x (size + 1) well below the project's max_connections (60 on the
# smallest compute); 8 suits 4-6 machines.
DATABASE_MAX_POOL_SIZE=8
# Port the server listens on (default 8000). The desktop app's launch.json has
# autoPort enabled and passes a free port in the PORT env var, which takes
# precedence over this file.
# PORT=8000
# Public origin of this deployment, for redirects and QR codes. Defaults to
# http://localhost:$PORT.
# BASE_URL=http://localhost:8000
# Absolute origin the browser calls for /api/*. Leave empty so the frontend
# uses the origin it was served from (works on any port). Set it only when the
# frontend is served from a different host than the API. Baked in at build time.
VITE_API_URL=
# Secret API key (sb_secret_...). When set, the Devcon handover forwards the
# attendee IP to Supabase Auth, so its rate limits apply per attendee rather
# than per server (also enable IP Address Forwarding in Authentication > Rate
# Limits).
SUPABASE_SECRET_KEY=
# Comma-separated origins allowed to call /api/* from a browser (default *).
CORS_ORIGINS=*
# Origin of the Pretalx instance whose schedules are synced into conferences
# with a pretalx_event slug (api/pretalx.ts). Leave empty to disable the sync
# endpoint.
PRETALX_URL=
# OpenRouter key for automatic question moderation. Leave empty to disable
# moderation; conferences opt in through conferences.moderation (see
# designs/002-question-moderation.md).
OPENROUTER_API_KEY=
# PostHog: server logs, traces and exceptions (OTLP) and browser error
# tracking. The project token (phc_...) and the ingestion host of the
# project's region, e.g. https://eu.i.posthog.com (required with the token).
# Leave the token empty to turn it off; logs then go to stdout only.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=
# Deployment name sent with everything to PostHog (development, dev, prod).
ENVIRONMENT=development
# Operator named on the privacy policy and terms (/legal), as JSON:
# {"name":"…","email":"…"}. Compiled into the bundle by `pnpm build`
# (vite.config.ts); unset shows "[operator not configured]".
LEGAL_OPERATOR=
